# Chanasta — Supabase (optional)
#
# With these two variables set, the app switches from local demo mode to real
# accounts (Supabase Auth + Postgres/RLS). Without them it runs fully in the
# browser with synthetic demo data.
#
# Local Supabase (no account needed):
#   npx supabase start
#   npx supabase status -o env        # prints ANON_KEY / API_URL
#
# Cloud Supabase: Project Settings -> API -> Project URL + anon public key.
# Never put the service_role key in this file or anywhere client-side.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>

# Optional runtime override instead of build-time env:
# add `window.CHANASTA_CONFIG = { supabaseUrl, supabaseAnonKey }` in a config.js
# loaded before the app bundle (see docs/self-hosting.md).
