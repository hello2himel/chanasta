# Chanasta security + cache headers (Netlify / Cloudflare Pages format).
#
# The only inline script in the app is the theme/language bootstrap in
# index.html; its sha256 is pinned below. Do not add inline scripts without
# updating the hash (or move them to a hashed external module).
#
# frame-ancestors is denied everywhere except /embed/* so creator cards can be
# embedded. Do not add X-Frame-Options: it would override CSP frame-ancestors.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-Vyc+bA7qQeuH13LherpDSrrt3enYEHI6OugIpbPwLQI=' https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://*.supabase.in wss://*.supabase.co; frame-src 'self'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

/embed/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-Vyc+bA7qQeuH13LherpDSrrt3enYEHI6OugIpbPwLQI=' https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://*.supabase.in wss://*.supabase.co; frame-src 'self'; frame-ancestors *; form-action 'self'
  Cross-Origin-Resource-Policy: cross-origin

/dashboard
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

/dashboard/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
